<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8" />
    <title>Login Alert</title>
  </head>

  <body style="font-family: Arial; background: #f5f5f5; padding: 30px">
    <div
      style="
        max-width: 600px;
        margin: auto;
        background: white;
        padding: 30px;
        border-radius: 10px;
      "
    >
      <h2 style="color: #4f46e5">Login Successful</h2>

      <p>Hello <strong><%= fullName %></strong>,</p>

      <p>You have successfully signed into your NovaGadget account.</p>

      <p>If this wasn't you, please change your password immediately.</p>

      <hr />

      <p>NovaGadget Security Team</p>
    </div>
  </body>
</html>
